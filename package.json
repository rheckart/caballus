{
  "name": "caballus",
  "version": "0.0.0",
  "private": true,
  "description": "Operations for a horse rescue.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env scripts/serve.mjs",
    "bootstrap": "node --env-file-if-exists=.env node_modules/.bin/jiti src/server/auth/bootstrap.cli.ts",
    "prepare": "husky",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fixtures": "node scripts/check-lint-fixtures.mjs",
    "check:control-bytes": "node scripts/check-control-bytes.mjs",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "drizzle-kit migrate",
    "verify": "npm run typecheck && npm run lint && npm run lint:fixtures && npm run check:control-bytes && npm run test && npm run db:check"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "repository": {
    "type": "git",
    "url": "https://git.heckart.me/rob/caballus.git"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.120.0",
    "@hono/node-server": "2.1.1",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-collapsible": "1.1.13",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.9",
    "@sentry/browser": "10.70.0",
    "@sentry/node": "10.70.0",
    "@tanstack/react-router": "1.170.29",
    "@tanstack/react-start": "1.168.46",
    "@tanstack/start-storage-context": "1.167.26",
    "better-auth": "^1.6.29",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.2",
    "jiti": "2.7.0",
    "lucide-react": "1.33.0",
    "luxon": "3.7.2",
    "nodemailer": "^9.0.5",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.86.0",
    "tailwind-merge": "3.6.0",
    "uuid": "14.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/luxon": "3.7.4",
    "@types/node": "26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-better-tailwindcss": "4.7.0",
    "husky": "9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
