{
  "name": "caballus",
  "version": "0.0.0",
  "private": true,
  "description": "Operations for a horse rescue.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env scripts/serve.mjs",
    "prepare": "husky",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fixtures": "node scripts/check-lint-fixtures.mjs",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "drizzle-kit migrate",
    "verify": "npm run typecheck && npm run lint && npm run lint:fixtures && npm run test && npm run db:check"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "repository": {
    "type": "git",
    "url": "https://git.heckart.me/rob/caballus.git"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@sentry/browser": "10.70.0",
    "@sentry/node": "10.70.0",
    "@tanstack/react-router": "1.170.29",
    "@tanstack/react-start": "1.168.46",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.2",
    "luxon": "3.7.2",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "uuid": "14.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/luxon": "3.7.4",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "drizzle-kit": "0.31.10",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
