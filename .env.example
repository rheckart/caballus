# What the application connects as: a non-superuser role, so that the
# row-level security policies of ADR 0007 apply to it. A table's owner bypasses
# its own policies, so this must never be the owner.
DATABASE_URL=postgres://caballus_app:caballus@localhost:5433/caballus

# What migrations connect as: the owner. Also what the integration tests seed
# with, since seeding two organisations is the only way to prove that a scoped
# query sees one of them.
ADMIN_DATABASE_URL=postgres://caballus:caballus@localhost:5433/caballus

# The organisation this deployment serves. One rescue; the column exists
# because retrofitting tenancy is the expensive direction, not because a second
# one is expected.
APP_ORG_ID=00000000-0000-0000-0000-000000000001

# Error reporting. Unset means no reports leave the machine, which is the right
# default for a development box.
SENTRY_DSN=
VITE_SENTRY_DSN=

# Better Auth's signing secret. There is no default: one that fell back to a
# constant would sign every volunteer out the day a real one was set, and ADR
# 0004 made permanent sessions the point. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Where this deployment answers, for the cookie's own idea of its origin.
APP_URL=http://localhost:3000

# The barn tablet's kiosk token (ADR 0022). Unset means there is no kiosk and
# only signed-in Volunteers can read the Board, which is the right default for
# a development box. The tablet is enrolled once by opening /board?token=<this>
# on it; rotating is changing this and restarting. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BOARD_TOKEN=

# Where the barn is, for the weather providers (ADR 0015). Configuration rather
# than a column: nothing in the application edits it, and unset means no
# forecast at all — which is the right default for a development box, and what
# a Reading refuses on rather than guessing at. Decimal degrees:
#   BARN_LATITUDE=39.4143
#   BARN_LONGITUDE=-77.4105
BARN_LATITUDE=
BARN_LONGITUDE=

# Outgoing mail (ADR 0009). Unset means no transport at all, which is the right
# default for a development box: nothing leaves the machine, and a sign-in
# fails loudly rather than appearing to work. Fastmail SMTP for the POC:
#   SMTP_URL=smtps://user%40heckart.me:app-password@smtp.fastmail.com:465
SMTP_URL=
EMAIL_FROM=Caballus <caballus@heckart.me>

# The Whiteboard Read's model key (ADR 0023). Unset means the endpoint refuses
# in words rather than failing obscurely, which is the right default for a
# development box: nothing calls out, and nobody is billed for a test run.
#
# It is an **OpenRouter** key rather than an Anthropic one — the rescue pays for
# one gateway subscription and this call comes out of it. The model is still
# claude-sonnet-5 and the wire shape is still Anthropic's own Messages API;
# only the base URL and this key differ, both in
# `src/server/whiteboard-read/model.ts`, which is the one module that knows
# either — the way `src/server/weather/providers.ts` is the one module that
# knows a forecast URL. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=
